# ── Google Gemini API ───────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Backend Configuration ───────────────────────────────────────
HOST=0.0.0.0
PORT=8000
YOLO_MODEL_PATH=yolov8n.pt
YOLO_IMG_SIZE=416
DEFAULT_CONFIDENCE=0.25

# ── Frontend Configuration ──────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000
